# =====================================================================================================
# SGA - Hospeda · Colección de pruebas de la API (cliente HTTP de IntelliJ / .http)
#
# Cómo usarla
#   1. Arrancar la aplicación (puerto 8080). Los datos de prueba se cargan solos al iniciar.
#   2. Elegir el entorno "local" (archivo http-client.env.json de esta carpeta) y ejecutar las
#      solicitudes EN ORDEN, de arriba hacia abajo: algunas guardan el código de la reserva creada
#      en una variable global (bloques "> {% ... %}") y las siguientes la usan.
#
# Supuestos sobre los datos iniciales (sembrados por persistencia). Ajustar estas dos variables si cambian:
#   - @apt          apartamento ACTIVO con tarifas completas y capacidad entre 2 y 10 personas.
#   - @aptBloqueo   OTRO apartamento activo con tarifas completas (se usa para los escenarios de bloqueo).
#   - Existe la temporada base, al menos una política de cancelación y el anticipo configurado es > 0.
# Todas las fechas de reserva están en 2028 para no chocar con las reservas sembradas.
#
# Seguridad (Guía 12): todo endpoint exige "Authorization: Bearer <token>" salvo el login y el registro.
#   - La PARTE 0 inicia sesión con los usuarios iniciales (uno por rol, application.properties), registra a la
#     huésped Ana Ramírez (titular de la reserva A) y guarda los tokens en variables globales.
#   - Cada solicitud usa el token del rol que la ejecuta en la vida real: la huésped cotiza, reserva por el
#     PORTAL a su nombre, consulta su reserva y su folio y la cancela; recepción toma las reservas por el canal
#     DIRECTO, cobra, confirma y opera; el administrador gestiona inventario, tarifas, políticas, bloqueos,
#     canal externo y autoriza cierres con saldo; el personal de servicio prepara los apartamentos.
#   - Los tokens duran 30 minutos: si vencen, vuelva a ejecutar la PARTE 0.
#
# Pruebas del cuerpo (client.test): un código HTTP correcto no basta, así que los escenarios nuevos (L-06: 1.2,
# 1.7 a 1.15 y 3.15a a 3.16f) comprueban el CUERPO de la respuesta: qué apartamentos devuelve cada filtro, el
# total cotizado, el mensaje de la regla violada y los campos de "errores". El resultado de cada aserción aparece
# en la pestaña de pruebas del cliente HTTP. Los escenarios 1.8 a 1.11 dependen de que el apartamento de demostración
# (DEMO-SIN-TARIFAS, que se edita en 3.16e) no tenga TERRAZA, PARQUEADERO, BALCON ni ACCESIBLE: no se le asignan.
#   - La PARTE 6 demuestra los casos 3 a 14 de la sección 9 de la Guía 12 (401 frente a 403 y propietario).
# Códigos: 400 forma · 401 sin token o token inválido · 403 rol o propietario · 404 no existe · 409 negocio.
# Cada escenario "409" indica la regla de negocio que viola.
# =====================================================================================================

# =====================================================================================================
# PARTE 0 · INICIO DE SESIÓN (públicos: no llevan token)
# =====================================================================================================

### 0.1 Login del administrador -> 200
POST {{host}}/api/auth/login
Content-Type: application/json

{"correo": "admin@sga.local", "contrasena": "Admin2026"}

> {%
    client.test("0.1 Login del administrador", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.tipo === "Bearer", "tipo: " + response.body.tipo);
        client.assert(typeof response.body.expiraEn === "string", "expiraEn debe ser string");
        client.assert(Array.isArray(response.body.roles), "roles debe ser una lista");
    });
    client.global.set("tokenAdmin", response.body.token);
%}

