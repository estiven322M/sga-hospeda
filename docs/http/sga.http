### 10.7 [7.2] El administrador crea un usuario interno con su rol -> 201 con Location
POST {{host}}/api/usuarios
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombre": "Carolina Pérez",
  "correo": "carolina@sga.local",
  "contrasena": "Interno2026",
  "telefono": "3001234567",
  "documento": "1094777888",
  "fechaNacimiento": "1992-06-18",
  "rol": "RECEPCIONISTA"
}

> {%
    client.test("10.7 [7.2] El administrador crea un usuario interno con su rol", function () {
        client.assert(response.status === 201, "código " + response.status);
        client.assert(response.headers.valueOf("Location").endsWith("/api/usuarios/" + response.body.id), "Location: " + response.headers.valueOf("Location"));
        client.assert(response.body.correo === "carolina@sga.local" && response.body.rol === "RECEPCIONISTA" && response.body.activo === true, "usuario creado: " + JSON.stringify(response.body));
        client.assert(JSON.stringify(response.body).toLowerCase().indexOf("contrasena") < 0 && JSON.stringify(response.body).indexOf("$2a$") < 0, "nunca se devuelve la contraseña ni su hash");
        client.global.set("idInterno", response.body.id);
    });
%}

### 10.8 [409 · 7.2 correo único] Crear un usuario con un correo ya registrado (sin distinguir mayúsculas) -> 409
POST {{host}}/api/usuarios
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombre": "Carolina Pérez",
  "correo": "Carolina@SGA.local",
  "contrasena": "Interno2026",
  "telefono": "3001234567",
  "documento": "1094777889",
  "fechaNacimiento": "1992-06-18",
  "rol": "RECEPCIONISTA"
}

> {%
    client.test("10.8 [409 · 7.2 correo único] Crear un usuario con un correo ya registrado (sin distinguir mayúsculas)", function () {
        client.assert(response.status === 409, "código " + response.status);
        client.assert(response.body.status === 409, "status del cuerpo: " + response.body.status);
        client.assert(typeof response.body.mensaje === "string" && response.body.mensaje.includes("Ya existe un usuario registrado con ese correo"), "mensaje: " + response.body.mensaje);
        client.assert(!response.body.errores, "solo los 400 de validación llevan errores");
        client.assert(response.body.trace === undefined && JSON.stringify(response.body).toLowerCase().indexOf("exception") < 0, "no debe devolver trazas técnicas");
    });
%}

