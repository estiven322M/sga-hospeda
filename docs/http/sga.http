### 9.38 [7.1 · 7.5] Recepción ve el calendario con el código y el estado de la reserva -> 200
GET {{host}}/api/apartamentos/{{apt}}/calendario?desde=2028-11-05&hasta=2028-11-10
Authorization: Bearer {{tokenRecepcion}}

> {%
    client.test("9.38 [7.1 · 7.5] Recepción ve el calendario con el código y el estado de la reserva", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.noches.length === 5, "cinco noches: " + response.body.noches.length);
        client.assert(response.body.noches[0].estado === "LIBRE" && response.body.noches[0].codigoReserva === null, "la noche del 5 está libre");
        client.assert([1, 2, 3].every(i => response.body.noches[i].estado === "RESERVADA" && response.body.noches[i].estadoReserva === "CONFIRMADA"), "las noches 6, 7 y 8 están reservadas y confirmadas");
        client.assert([1, 2, 3].every(i => response.body.noches[i].codigoReserva === client.global.get("codigoServicios")), "traen el código de la reserva");
        client.assert(response.body.noches[4].estado === "LIBRE", "la noche del 9 (la de la salida) queda libre");
    });
%}

### 9.39 [7.1] El huésped solo ve LIBRE o NO_DISPONIBLE, sin saber de quién es la reserva -> 200
GET {{host}}/api/apartamentos/{{apt}}/calendario?desde=2028-11-05&hasta=2028-11-10
Authorization: Bearer {{tokenHuesped1}}

> {%
    client.test("9.39 [7.1] El huésped solo ve LIBRE o NO_DISPONIBLE, sin saber de quién es la reserva", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.noches[0].estado === "LIBRE", "la noche del 5 está libre");
        client.assert([1, 2, 3].every(i => response.body.noches[i].estado === "NO_DISPONIBLE"), "las noches reservadas se ven como NO_DISPONIBLE");
        client.assert(response.body.noches.every(n => n.codigoReserva === null && n.estadoReserva === null), "el huésped no ve códigos ni estados de reservas");
        client.assert(response.body.noches[4].estado === "LIBRE", "la noche de la salida queda libre");
    });
%}

