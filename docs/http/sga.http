# =====================================================================================================
# PARTE 11 · IMÁGENES DE APARTAMENTOS Y FOTO DE PERFIL (J8: 7.3, 7.2, 7.5, I-01 a I-08)
#   Las imágenes se suben con multipart/form-data (parte "imagenes"; hasta 10 por apartamento, JPG, PNG o WEBP de hasta 5 MB) y la
#   foto de perfil con la parte "foto" (hasta 2 MB). Los archivos de ejemplo están en docs/http/imagenes/ (las líneas "< ./imagenes/x"
#   son la sintaxis del cliente HTTP de IntelliJ y las lee también ejecutar-coleccion.js). El formato se reconoce por el CONTENIDO:
#   un texto renombrado a .jpg se rechaza. El proveedor de almacenamiento es el local (el que viene activo): las imágenes se
#   sirven en /imagenes/** sin token. Los límites de tamaño (5 MB y 2 MB) y el 503 del almacén externo caído se verifican en
#   RecorridoImagenesIntegracionTest y RecorridoImagenesFalloIntegracionTest (la colección no adjunta archivos de varios megas).
# =====================================================================================================

### 11.1 [7.3] Todo apartamento ACTIVO tiene imágenes y exactamente una principal (listado) -> 200
GET {{host}}/api/apartamentos
Authorization: Bearer {{tokenHuesped1}}

> {%
    client.test("11.1 [7.3] Todo apartamento ACTIVO tiene imágenes y exactamente una principal (listado)", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.contenido.length >= 7, "apartamentos: " + response.body.contenido.length);
        client.assert(response.body.contenido.every(ap => ap.imagenes.length === 0 ? !ap.activo : ap.imagenes.filter(i => i.principal).length === 1), "los activos tienen imágenes y cada galería, una sola principal");
        client.assert(response.body.contenido.every(ap => ap.imagenes.length === 0 ? ap.imagenPrincipal === null : ap.imagenPrincipal === ap.imagenes.filter(i => i.principal)[0].url), "imagenPrincipal es la URL de la principal (nula sin imágenes)");
    });
%}

### 11.2 [7.3] El detalle trae la galería y la URL de la principal -> 200
GET {{host}}/api/apartamentos/{{apt}}
Authorization: Bearer {{tokenHuesped1}}

> {%
    client.test("11.2 [7.3] El detalle trae la galería y la URL de la principal", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.imagenPrincipal.indexOf("/imagenes/apartamentos/APT-101/") > 0, "imagenPrincipal: " + response.body.imagenPrincipal);
        client.assert(response.body.imagenes.length === 2, "las dos imágenes de ejemplo sembradas: " + response.body.imagenes.length);
        client.assert(response.body.imagenes.filter(i => i.principal).length === 1, "exactamente una principal: " + JSON.stringify(response.body.imagenes));
        client.global.set("imagenPrincipalApt", response.body.imagenPrincipal);
        client.global.set("idImagenOriginal", response.body.imagenes[0].id);
    });
%}

