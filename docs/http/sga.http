### 11.30 [7.2] El huésped cambia su foto de perfil (multipart, parte "foto") -> 200
PUT {{host}}/api/usuarios/yo/foto
Authorization: Bearer {{tokenHuesped1}}
Content-Type: multipart/form-data; boundary=SgaFrontera

--SgaFrontera
Content-Disposition: form-data; name="foto"; filename="fachada.png"
Content-Type: image/png

< ./imagenes/fachada.png
--SgaFrontera--

> {%
    client.test("11.30 [7.2] El huésped cambia su foto de perfil (multipart, parte \"foto\")", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.fotoUrl.indexOf("/imagenes/perfiles/") > 0 && response.body.fotoUrl.endsWith(".png"), "fotoUrl: " + response.body.fotoUrl);
        client.assert(response.body.correo === "huesped1@sga.local" && JSON.stringify(response.body).toLowerCase().indexOf("contrasena") < 0, "es la foto del dueño del token y no trae secretos");
        client.global.set("fotoHuesped", response.body.fotoUrl);
    });
%}

