### 8.16 [GET /api/apartamentos?estadoOperativo=] El personal de servicio ve los apartamentos fuera de servicio -> 200: APT-302
GET {{host}}/api/apartamentos?estadoOperativo=FUERA_DE_SERVICIO
Authorization: Bearer {{tokenServicio}}

> {%
    client.test("8.16 el filtro por estado operativo devuelve solo los que están en ese estado", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.contenido.length >= 1, "debe haber al menos uno");
        client.assert(response.body.contenido.every(a => a.estadoOperativo === "FUERA_DE_SERVICIO"), "todos fuera de servicio");
        client.assert(response.body.contenido.some(a => a.identificacion === "APT-302"), "APT-302 está sembrado fuera de servicio");
    });
%}

### 8.17 [GET /api/apartamentos?estadoOperativo=] Se combina con las características: BALCON y PREPARADO -> 200 sin el 302
GET {{host}}/api/apartamentos?caracteristicas=BALCON&estadoOperativo=PREPARADO
Authorization: Bearer {{tokenRecepcion}}

> {%
    client.test("8.17 el estado operativo se combina con las características", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.contenido.every(a => a.estadoOperativo === "PREPARADO" && a.caracteristicas.indexOf("BALCON") >= 0),
            "todos PREPARADOS y con BALCON");
        client.assert(response.body.contenido.every(a => a.identificacion !== "APT-302"), "APT-302 está fuera de servicio");
    });
%}

