# ---------- L-06 · Características de los apartamentos y su filtro ----------
# Datos sembrados: TERRAZA = APT-102 y APT-301 · BALCON = APT-101, APT-201 y APT-302 · ACCESIBLE = APT-202 y APT-203
# PARQUEADERO = APT-102 y APT-202 · JACUZZI = APT-301 · VISTA_AL_PARQUE = APT-101 · VISTA_PANORAMICA = APT-301.
# Cada escenario verifica el CUERPO (qué apartamentos devuelve), no solo el código.

### 1.7 [L-06] Catálogo cerrado de características -> 200 con los 7 valores
GET {{host}}/api/caracteristicas
Authorization: Bearer {{tokenHuesped1}}

> {%
    client.test("1.7 el catálogo trae las 7 características", function () {
        client.assert(response.status === 200, "código " + response.status);
        const esperadas = ["ACCESIBLE", "BALCON", "JACUZZI", "PARQUEADERO", "TERRAZA", "VISTA_AL_PARQUE", "VISTA_PANORAMICA"];
        client.assert(JSON.stringify(response.body.slice().sort()) === JSON.stringify(esperadas),
            "catálogo: " + response.body);
    });
%}

### 1.8 [L-06] Listar filtrando por TERRAZA -> 200: exactamente APT-102 y APT-301
GET {{host}}/api/apartamentos?caracteristicas=TERRAZA
Authorization: Bearer {{tokenRecepcion}}

> {%
    client.test("1.8 TERRAZA devuelve solo APT-102 y APT-301", function () {
        client.assert(response.status === 200, "código " + response.status);
        const ids = response.body.contenido.map(a => a.identificacion).sort();
        client.assert(JSON.stringify(ids) === JSON.stringify(["APT-102", "APT-301"]), "ids devueltos: " + ids);
        client.assert(response.body.totalElementos === 2, "totalElementos: " + response.body.totalElementos);
        client.assert(response.body.contenido.every(a => a.caracteristicas.indexOf("TERRAZA") >= 0),
            "todos deben tener TERRAZA");
    });
%}

### 1.9 [L-06] Varias características exigen TODAS (TERRAZA y PARQUEADERO) -> 200: solo APT-102
GET {{host}}/api/apartamentos?caracteristicas=TERRAZA&caracteristicas=PARQUEADERO
Authorization: Bearer {{tokenRecepcion}}

> {%
    client.test("1.9 TERRAZA + PARQUEADERO devuelve solo APT-102", function () {
        client.assert(response.status === 200, "código " + response.status);
        const ids = response.body.contenido.map(a => a.identificacion);
        client.assert(JSON.stringify(ids) === JSON.stringify(["APT-102"]), "ids devueltos: " + ids);
    });
%}

### 1.10 [L-06] Combinación que ningún apartamento cumple (BALCON y ACCESIBLE) -> 200 con la página vacía
GET {{host}}/api/apartamentos?caracteristicas=BALCON&caracteristicas=ACCESIBLE
Authorization: Bearer {{tokenRecepcion}}

> {%
    client.test("1.10 sin coincidencias: contenido vacío", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.contenido.length === 0, "contenido: " + response.body.contenido.length);
        client.assert(response.body.totalElementos === 0, "totalElementos: " + response.body.totalElementos);
    });
%}

### 1.11 [400 · L-06] Una característica fuera del catálogo -> 400 con ErrorResponse
GET {{host}}/api/apartamentos?caracteristicas=PISCINA
Authorization: Bearer {{tokenRecepcion}}

> {%
    client.test("1.11 PISCINA no está en el catálogo", function () {
        client.assert(response.status === 400, "código " + response.status);
        client.assert(response.body.status === 400, "status del cuerpo: " + response.body.status);
        client.assert(typeof response.body.mensaje === "string" && response.body.mensaje.length > 0, "falta el mensaje");
        client.assert(response.body.trace === undefined, "no debe devolver trazas técnicas");
    });
%}

### 1.12 [L-06] Disponibilidad filtrando por JACUZZI (3 noches de agosto de 2028, 1 adulto) -> 200: solo APT-301, 420.000
POST {{host}}/api/disponibilidad
Authorization: Bearer {{tokenHuesped1}}
Content-Type: application/json

{
  "fechaEntrada": "2028-08-21",
  "fechaSalida": "2028-08-24",
  "caracteristicas": ["JACUZZI"],
  "ocupantes": [{"documento": "CC-7001", "nombre": "Adulto Uno", "fechaNacimiento": "1990-01-01"}]
}

> {%
    client.test("1.12 JACUZZI devuelve solo APT-301 con su cotización", function () {
        client.assert(response.status === 200, "código " + response.status);
        const ids = response.body.contenido.map(a => a.identificacion);
        client.assert(JSON.stringify(ids) === JSON.stringify(["APT-301"]), "ids devueltos: " + ids);
        const tarjeta = response.body.contenido[0];
        client.assert(tarjeta.total === 420000, "total: " + tarjeta.total);
        client.assert(tarjeta.desglose.length === 3, "noches del desglose: " + tarjeta.desglose.length);
        client.assert(tarjeta.caracteristicas.indexOf("JACUZZI") >= 0, "la tarjeta debe traer sus características");
        client.assert(tarjeta.descripcion.length > 0, "la tarjeta debe traer la descripción");
    });
%}

