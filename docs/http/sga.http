    client.test("3.22 CU-04 [RN-14] Cambiar la reserva C de apartamento (misma estancia): se revalida y se recotiza contra e...", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.estado === "PENDIENTE", "estado: " + response.body.estado);
        client.assert(response.body.canalOrigen === "DIRECTO", "canalOrigen: " + response.body.canalOrigen);
        client.assert(response.body.identificacionApartamento === "APT-102", "identificacionApartamento: " + response.body.identificacionApartamento);
        client.assert(typeof response.body.fechaEntrada === "string", "fechaEntrada debe ser string");
