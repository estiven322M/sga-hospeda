        client.assert(response.status === 201, "código " + response.status);
        client.assert(response.body.nombre === "Ana Ramírez", "nombre: " + response.body.nombre);
        client.assert(typeof response.body.documento === "string", "documento debe ser string");
        client.assert(typeof response.body.rol === "string", "rol debe ser string");
    });
%}

