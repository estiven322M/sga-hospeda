@apt = APT-101
@aptBloqueo = APT-102

# =====================================================================================================
# PARTE 1 · CONSULTAS DE REFERENCIA
# =====================================================================================================

### 1.1 Listar apartamentos (de 10 en 10)
GET {{host}}/api/apartamentos?pagina=0
Authorization: Bearer {{tokenRecepcion}}


> {%
    client.test("1.1 Listar apartamentos (de 10 en 10)", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(Array.isArray(response.body.contenido), "contenido debe ser una lista");
        client.assert(response.body.tamanio === 10, "tamanio: " + response.body.tamanio);
        client.assert(typeof response.body.totalElementos === "number" && typeof response.body.totalPaginas === "number", "totales");
        client.assert(response.body.contenido.length > 0, "la página no debe estar vacía");
        client.assert(response.body.contenido[0].identificacion === "APT-101", "identificacion: " + response.body.contenido[0].identificacion);
        client.assert(response.body.contenido[0].nombre === "Apartamento 101 - Vista al parque", "nombre: " + response.body.contenido[0].nombre);
        client.assert(typeof response.body.contenido[0].descripcion === "string", "descripcion debe ser string");
        client.assert(typeof response.body.contenido[0].dormitorios === "number", "dormitorios debe ser number");
        client.assert(typeof response.body.contenido[0].capacidad === "number", "capacidad debe ser number");
        client.assert(Array.isArray(response.body.contenido[0].dotacion), "dotacion debe ser una lista");
        client.assert(Array.isArray(response.body.contenido[0].caracteristicas), "caracteristicas debe ser una lista");
        client.assert(response.body.contenido[0].estadoOperativo === "PREPARADO", "estadoOperativo: " + response.body.contenido[0].estadoOperativo);
        client.assert(response.body.contenido[0].activo === true, "activo: " + response.body.contenido[0].activo);
    });
%}
### 1.2 Consultar un apartamento (L-06: trae descripción, dotación y características) -> 200
GET {{host}}/api/apartamentos/{{apt}}
Authorization: Bearer {{tokenRecepcion}}

> {%
    client.test("1.2 el apartamento trae sus datos descriptivos", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.identificacion === "APT-101", "identificación: " + response.body.identificacion);
        client.assert(response.body.descripcion && response.body.descripcion.length > 0, "falta la descripción");
        client.assert(response.body.dotacion.length > 0, "falta la dotación");
        client.assert(response.body.caracteristicas.indexOf("VISTA_AL_PARQUE") >= 0, "falta VISTA_AL_PARQUE");
        client.assert(response.body.caracteristicas.indexOf("BALCON") >= 0, "falta BALCON");
    });
%}

