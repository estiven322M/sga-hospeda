        client.assert(response.status === 409, "código " + response.status);
        client.assert(response.body.mensaje === "En temporada ALTA la estancia mínima es de 3 noches", "mensaje: " + response.body.mensaje);
    });
%}

### 7.3 [RP-01] Con exactamente 3 noches en ALTA la cotización funciona -> 200, 3 x 192.000 = 576.000
POST {{host}}/api/cotizaciones
Authorization: Bearer {{tokenRecepcion}}
Content-Type: application/json

{
  "identificacionApartamento": "{{apt}}",
  "fechaEntrada": "2028-07-11",
  "fechaSalida": "2028-07-14",
  "ocupantes": [{"documento": "CC-9701", "nombre": "Adulto Uno", "fechaNacimiento": "1990-01-01"}]
}

> {%
    client.test("7.3 tres noches en ALTA se cotizan a la tarifa de ALTA", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.noches === 3, "noches: " + response.body.noches);
        client.assert(response.body.desglose.every(n => n.temporada === "ALTA"), "todas las noches deben ser ALTA");
        client.assert(response.body.total === 576000, "total: " + response.body.total);
        client.assert(response.body.porcentajeDescuento === 0, "no hay descuento con 3 noches");
    });
%}

