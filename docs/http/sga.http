  "nombre": "Ana Ramírez",
  "correo": "ana.ramirez@correo.com",
  "contrasena": "AnaRamirez2026",
  "telefono": "3104445566",
  "documento": "CC-9001",
  "fechaNacimiento": "1990-05-12"
}

> {%
