# =====================================================================================================
# PARTE 7 · REGLAS PROPIAS (L-20) · aprobación del docente solicitada el 15-nov-2026
#
#   RP-01 Estancia mínima por temporada: si alguna noche cae en ALTA (3 noches) o MEDIA (2 noches), la estancia debe tener
#         al menos ese número de noches. Aplica al cotizar, crear, modificar y buscar disponibilidad -> 409.
#   RP-02 Descuento por estancia larga: desde 7 noches, 10 % sobre el total, aplicado una sola vez y congelado en la
#         reserva. No rechaza: calcula distinto (se ve en el cuerpo de la cotización y de la reserva).
#   RP-03 Adulto responsable: toda reserva incluye al menos un ocupante con 18 años o más a la fecha de entrada. Aplica al
#         crear y al modificar -> 409. NO se valida al cotizar: la cotización calcula precio, la composición del grupo se
#         exige al reservar (7.8).
# Calendario de 2028: ALTA del 15-jun al 15-jul · MEDIA del 30-abr al 4-may · el resto es BASE. Tarifas de APT-101 por
# ocupante facturable y noche: BASE 120.000 · ALTA 192.000. Todos los escenarios verifican el CUERPO.
# =====================================================================================================

### 7.1 [409 · RP-01] Cotizar UNA noche en temporada ALTA (11 al 12 de julio) -> 409
POST {{host}}/api/cotizaciones
Authorization: Bearer {{tokenRecepcion}}
Content-Type: application/json

{
  "identificacionApartamento": "{{apt}}",
  "fechaEntrada": "2028-07-11",
  "fechaSalida": "2028-07-12",
  "ocupantes": [{"documento": "CC-9701", "nombre": "Adulto Uno", "fechaNacimiento": "1990-01-01"}]
}

> {%
    client.test("7.1 una noche en ALTA viola la estancia mínima", function () {
        client.assert(response.status === 409, "código " + response.status);
        client.assert(response.body.status === 409, "status del cuerpo: " + response.body.status);
        client.assert(response.body.mensaje === "En temporada ALTA la estancia mínima es de 3 noches", "mensaje: " + response.body.mensaje);
        client.assert(response.body.trace === undefined && JSON.stringify(response.body).indexOf("Exception") < 0,
            "no debe devolver trazas técnicas");
    });
%}

