### 11.10 [7.3] El administrador sube dos imágenes (PNG y JPG): 201 con Location y la galería -> 201
POST {{host}}/api/apartamentos/{{apt}}/imagenes
Authorization: Bearer {{tokenAdmin}}
Content-Type: multipart/form-data; boundary=SgaFrontera

--SgaFrontera
Content-Disposition: form-data; name="imagenes"; filename="fachada.png"
Content-Type: image/png

< ./imagenes/fachada.png
--SgaFrontera
Content-Disposition: form-data; name="imagenes"; filename="sala.jpg"
Content-Type: image/jpeg

< ./imagenes/sala.jpg
--SgaFrontera--

> {%
    client.test("11.10 [7.3] El administrador sube dos imágenes (PNG y JPG): 201 con Location y la galería", function () {
        client.assert(response.status === 201, "código " + response.status);
        client.assert(response.headers.valueOf("Location").endsWith("/api/apartamentos/APT-101"), "Location: " + response.headers.valueOf("Location"));
        client.assert(response.body.imagenes.length === 4, "2 sembradas + 2 nuevas: " + response.body.imagenes.length);
        client.assert(response.body.imagenPrincipal === client.global.get("imagenPrincipalApt"), "subir no cambia la principal");
        client.assert(response.body.imagenes.filter(i => i.principal).length === 1, "exactamente una principal: " + JSON.stringify(response.body.imagenes));
        client.assert(response.body.imagenes[2].url.endsWith(".png") && response.body.imagenes[3].url.endsWith(".jpg"), "extensión según el contenido: " + response.body.imagenes[2].url);
        client.global.set("idImagenNueva", response.body.imagenes[2].id);
    });
%}

