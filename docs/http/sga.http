### 10.33 [10.3.2-A] La bandeja de notificaciones (proveedor local) trae el código de 6 dígitos enviado -> 200
GET {{host}}/api/notificaciones
Authorization: Bearer {{tokenAdmin}}

> {%
    client.test("10.33 [10.3.2-A] La bandeja de notificaciones (proveedor local) trae el código de 6 dígitos enviado", function () {
        client.assert(response.status === 200, "código " + response.status);
        var aviso = response.body.contenido[0];
        client.assert(aviso.tipo === "CODIGO_RECUPERACION" && aviso.destinatario === "carolina@sga.local" && aviso.estado === "ENVIADA", "aviso: " + JSON.stringify(aviso));
        var codigo = /es (\d{6})\./.exec(aviso.mensaje);
        client.assert(codigo !== null, "el mensaje lleva el código de 6 dígitos: " + aviso.mensaje);
        client.assert(aviso.codigoReserva === null, "el aviso de recuperación no pertenece a una reserva");
        client.global.set("codigoRecuperacion", codigo[1]);
    });
%}

