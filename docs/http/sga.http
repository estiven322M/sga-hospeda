# =====================================================================================================
# PARTE 9 · ALOJAMIENTO, SERVICIOS ADICIONALES, MEDIOS DE PAGO Y CALENDARIOS (J6: L-01, L-02, L-16, L-17, L-18, 7.1, 7.3, 7.5)
#   Los datos del alojamiento son públicos; editarlos y ver los parámetros es del administrador. Los servicios se gestionan
#   con baja lógica y se cargan al folio de una reserva CONFIRMADA o EN_CURSO. El pago exige un medio aceptado. El calendario
#   muestra el estado de cada noche y baja el detalle para el huésped. Todas las aserciones comprueban el CUERPO.
# =====================================================================================================

### 9.1 [L-01 · L-02 · L-16 · L-18] La consulta del alojamiento es PÚBLICA: sin token -> 200
GET {{host}}/api/alojamiento

> {%
    client.test("9.1 [L-01 · L-02 · L-16 · L-18] La consulta del alojamiento es PÚBLICA: sin token", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.nombre === "Hospeda Salento", "nombre: " + response.body.nombre);
        client.assert(response.body.ciudad === "Salento, Quindío", "ciudad: " + response.body.ciudad);
        client.assert(typeof response.body.latitud === "number" && typeof response.body.longitud === "number", "latitud y longitud deben ser números");
        client.assert(response.body.horaEntrada === "15:00:00" && response.body.horaSalida === "11:00:00", "horas: " + response.body.horaEntrada + " / " + response.body.horaSalida);
        client.assert(response.body.politicaMascotas === "No se aceptan mascotas.", "política de mascotas: " + response.body.politicaMascotas);
        client.assert(response.body.normasConvivencia.length > 0, "debe traer las normas de convivencia");
        client.assert(response.body.mediosPago.length >= 2 && response.body.mediosPago.indexOf("EFECTIVO") >= 0, "medios de pago: " + response.body.mediosPago);
    });
%}

### 9.2 [403 · alojamiento] Recepción intenta editar el alojamiento (es del administrador) -> 403
PUT {{host}}/api/alojamiento
Authorization: Bearer {{tokenRecepcion}}
Content-Type: application/json

{
  "nombre": "Hospeda Salento",
  "descripcion": "Apartamentos turísticos con vista al Valle del Cocora, a pocos pasos de la plaza principal de Salento.",
  "ciudad": "Salento, Quindío",
  "direccion": "Carrera 6 # 3-45, Salento, Quindío",
  "latitud": 4.6368,
  "longitud": -75.57,
  "horaEntrada": "15:00",
  "horaSalida": "11:00",
  "normasConvivencia": "Silencio entre las 10 p. m. y las 7 a. m. No se permite fumar dentro de los apartamentos.",
  "politicaMascotas": "No se aceptan mascotas."
}

> {%
    client.test("9.2 [403 · alojamiento] Recepción intenta editar el alojamiento (es del administrador)", function () {
        client.assert(response.status === 403, "código " + response.status);
        client.assert(response.body.status === 403, "status del cuerpo: " + response.body.status);
        client.assert(response.body.trace === undefined && JSON.stringify(response.body).toLowerCase().indexOf("exception") < 0, "no debe devolver trazas técnicas");
    });
%}

