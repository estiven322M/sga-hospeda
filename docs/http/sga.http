Content-Type: application/json

{"autor": "Ana Ramírez"}

> {%
    client.test("2.5 [409 · L-11 anticipo] Confirmar SIN haber pagado el anticipo", function () {
        client.assert(response.status === 409, "código " + response.status);
        client.assert(response.body.status === 409, "status del cuerpo: " + response.body.status);
        client.assert(typeof response.body.mensaje === "string" && response.body.mensaje.includes("Para confirmar la reserva debe registrarse un anticipo de"), "mensaje: " + response.body.mensaje);
        client.assert(!response.body.errores, "solo los 400 de validación llevan errores");
        client.assert(response.body.trace === undefined && JSON.stringify(response.body).toLowerCase().indexOf("exception") < 0, "no debe devolver trazas técnicas");
    });
