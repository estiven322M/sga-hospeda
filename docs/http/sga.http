        client.assert(typeof response.body.titular.documento === "string", "documento debe ser string");
        client.assert(response.body.titular.nombre === "Carlos Vega", "nombre: " + response.body.titular.nombre);
        client.assert(typeof response.body.titular.fechaNacimiento === "string", "fechaNacimiento debe ser string");
        client.assert(Array.isArray(response.body.ocupantes), "ocupantes debe ser una lista");
        client.assert(typeof response.body.valorTotal === "number", "valorTotal debe ser number");
        client.assert(typeof response.body.subtotalBruto === "number", "subtotalBruto debe ser number");
        client.assert(typeof response.body.porcentajeDescuento === "number", "porcentajeDescuento debe ser number");
        client.assert(typeof response.body.descuento === "number", "descuento debe ser number");
        client.assert(response.body.moneda === "COP", "moneda: " + response.body.moneda);
