### 6.8 [caso 8] Recepción lista las reservas pendientes -> 200. Guarda el código de la reserva de la huésped 1
GET {{host}}/api/reservas?titular=1094000111
Authorization: Bearer {{tokenRecepcion}}

> {%
    client.test("6.8 [caso 8] Recepción lista las reservas pendientes", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(Array.isArray(response.body.contenido), "contenido debe ser una lista");
        client.assert(response.body.tamanio === 10, "tamanio: " + response.body.tamanio);
        client.assert(typeof response.body.totalElementos === "number" && typeof response.body.totalPaginas === "number", "totales");
        client.assert(response.body.contenido.length > 0, "la página no debe estar vacía");
        client.assert(response.body.contenido[0].estado === "PENDIENTE", "estado: " + response.body.contenido[0].estado);
        client.assert(response.body.contenido[0].canalOrigen === "PORTAL", "canalOrigen: " + response.body.contenido[0].canalOrigen);
        client.assert(response.body.contenido[0].identificacionApartamento === "APT-201", "identificacionApartamento: " + response.body.contenido[0].identificacionApartamento);
        client.assert(typeof response.body.contenido[0].fechaEntrada === "string", "fechaEntrada debe ser string");
        client.assert(typeof response.body.contenido[0].fechaSalida === "string", "fechaSalida debe ser string");
        client.assert(typeof response.body.contenido[0].nombreTitular === "string", "nombreTitular debe ser string");
        client.assert(typeof response.body.contenido[0].totalOcupantes === "number", "totalOcupantes debe ser number");
        client.assert(typeof response.body.contenido[0].valorTotal === "number", "valorTotal debe ser number");
    });
    client.global.set("codigoHuesped1", response.body.contenido[0].codigo);
%}

