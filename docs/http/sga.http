### 9.50 [7.3] Bajar la capacidad a 1: la respuesta avisa de la reserva de dos personas y la actualización no se bloquea -> 200
PUT {{host}}/api/apartamentos/{{apt}}
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombre": "{{aptNombre}}",
  "descripcion": "{{aptDescripcion}}",
  "dormitorios": {{aptDormitorios}},
  "capacidad": 1,
  "dotacion": {{aptDotacion}},
  "caracteristicas": {{aptCaracteristicas}}
}

> {%
    client.test("9.50 [7.3] Bajar la capacidad a 1: la respuesta avisa de la reserva de dos personas y la actualización no se bloquea", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.capacidad === 1, "la capacidad se actualizó: " + response.body.capacidad);
        client.assert(response.body.reservasPorEncimaDeLaCapacidad.length >= 1, "debe avisar de al menos una reserva");
        client.assert(response.body.reservasPorEncimaDeLaCapacidad.some(r => r.codigo === client.global.get("codigoServicios") && r.totalOcupantes === 2), "debe listar la reserva de dos ocupantes: " + JSON.stringify(response.body.reservasPorEncimaDeLaCapacidad));
    });
%}

### 9.51 [7.3] La reserva que quedó por encima conserva sus dos ocupantes -> 200
GET {{host}}/api/reservas/{{codigoServicios}}
Authorization: Bearer {{tokenRecepcion}}

> {%
    client.test("9.51 [7.3] La reserva que quedó por encima conserva sus dos ocupantes", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.ocupantes.length === 2, "cambiar la capacidad no afecta las reservas ya creadas: " + response.body.ocupantes.length);
    });
%}

### 9.52 [7.3] Se restablece la capacidad: sin bajarla no hay aviso -> 200
PUT {{host}}/api/apartamentos/{{apt}}
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombre": "{{aptNombre}}",
  "descripcion": "{{aptDescripcion}}",
  "dormitorios": {{aptDormitorios}},
  "capacidad": {{aptCapacidad}},
  "dotacion": {{aptDotacion}},
  "caracteristicas": {{aptCaracteristicas}}
}

> {%
    client.test("9.52 [7.3] Se restablece la capacidad: sin bajarla no hay aviso", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.capacidad === Number(client.global.get("aptCapacidad")), "capacidad restablecida: " + response.body.capacidad);
        client.assert(response.body.reservasPorEncimaDeLaCapacidad.length === 0, "subir la capacidad no avisa de nada");
    });
%}

# =====================================================================================================
# PARTE 10 · NOTIFICACIONES AL TITULAR, GESTIÓN DE USUARIOS, PERFIL Y RECUPERACIÓN DE CONTRASEÑA (J7: 7.2, 10.3.2-A, I-01 a I-08)
#   El administrador crea usuarios internos, cambia roles y los desactiva (lógico: nunca a un titular con reservas PENDIENTE,
#   CONFIRMADA o EN_CURSO, ni a sí mismo). Cada usuario edita su nombre y su teléfono (no su correo) y cambia su contraseña.
#   La recuperación envía un código de 6 dígitos (15 minutos, un solo uso) al correo, con una respuesta genérica que no revela
#   si el correo existe. Con el proveedor de notificaciones local (el que viene activo) el código y los avisos de la reserva
#   se leen en GET /api/notificaciones (solo ADMINISTRADOR). Todas las aserciones comprueban el CUERPO.
# =====================================================================================================

### 10.1 [7.2] El administrador lista los usuarios de 10 en 10, sin contraseñas -> 200
GET {{host}}/api/usuarios
Authorization: Bearer {{tokenAdmin}}

> {%
    client.test("10.1 [7.2] El administrador lista los usuarios de 10 en 10, sin contraseñas", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.tamanio === 10 && response.body.pagina === 0, "página de 10: " + response.body.tamanio);
        client.assert(response.body.contenido.length >= 6, "los 6 usuarios iniciales (más el huésped registrado): " + response.body.contenido.length);
        client.assert(response.body.contenido.some(u => u.correo === "admin@sga.local" && u.rol === "ADMINISTRADOR" && u.activo === true), "debe listar al administrador activo");
        client.assert(JSON.stringify(response.body).toLowerCase().indexOf("contrasena") < 0 && JSON.stringify(response.body).indexOf("$2a$") < 0, "nunca se devuelve la contraseña ni su hash");
    });
%}

