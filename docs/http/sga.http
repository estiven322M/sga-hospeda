# =====================================================================================================
# SGA - Hospeda · Colección de pruebas de la API (cliente HTTP de IntelliJ / .http)
#
# Cómo usarla
#   1. Arrancar la aplicación (puerto 8080). Los datos de prueba se cargan solos al iniciar.
#   2. Elegir el entorno "local" (archivo http-client.env.json de esta carpeta) y ejecutar las
#      solicitudes EN ORDEN, de arriba hacia abajo: algunas guardan el código de la reserva creada
#      en una variable global (bloques "> {% ... %}") y las siguientes la usan.
#
# Supuestos sobre los datos iniciales (sembrados por persistencia). Ajustar estas dos variables si cambian:
#   - @apt          apartamento ACTIVO con tarifas completas y capacidad entre 2 y 10 personas.
#   - @aptBloqueo   OTRO apartamento activo con tarifas completas (se usa para los escenarios de bloqueo).
#   - Existe la temporada base, al menos una política de cancelación y el anticipo configurado es > 0.
# Todas las fechas de reserva están en 2028 para no chocar con las reservas sembradas.
#
# Sin seguridad (el docente indicó que el backend se desarrolla sin JWT): no hay casos 401/403.
# Cada escenario "409" indica la regla de negocio que viola. Códigos: 400 forma, 404 no existe, 409 negocio.
# =====================================================================================================

@apt = APT-101
@aptBloqueo = APT-102

# =====================================================================================================
# PARTE 1 · CONSULTAS DE REFERENCIA
# =====================================================================================================

### 1.1 Listar apartamentos (de 10 en 10)
GET {{host}}/api/apartamentos?pagina=0

### 1.2 Consultar un apartamento
GET {{host}}/api/apartamentos/{{apt}}

### 1.3 Listar temporadas
GET {{host}}/api/temporadas

### 1.4 Tarifas del apartamento (una por temporada)
GET {{host}}/api/apartamentos/{{apt}}/tarifas

### 1.5 Política de cancelación vigente
GET {{host}}/api/politicas-cancelacion/vigente

### 1.6 Bloqueos del apartamento
GET {{host}}/api/apartamentos/{{aptBloqueo}}/bloqueos

# =====================================================================================================
# PARTE 2 · FLUJO COMPLETO DE UNA RESERVA (todos deben dar 2xx salvo los marcados 409)
# =====================================================================================================

### 2.1 CU-01 Cotizar la estancia (2 adultos y 1 niño: el niño no genera cargo, RN-05 y RN-06) -> 200
POST {{host}}/api/cotizaciones
Content-Type: application/json

{
  "identificacionApartamento": "{{apt}}",
  "fechaEntrada": "2028-03-10",
  "fechaSalida": "2028-03-12",
  "ocupantes": [
    {"documento": "CC-9001", "nombre": "Ana Ramírez", "fechaNacimiento": "1990-05-12"},
    {"documento": "CC-9002", "nombre": "Luis Gómez", "fechaNacimiento": "1988-02-20"},
    {"documento": "TI-9003", "nombre": "Sofía Gómez", "fechaNacimiento": "2020-03-02"}
  ]
}

### 2.2 CU-02 Consultar disponibilidad de la misma estancia (filtro de capacidad mínima) -> 200
POST {{host}}/api/disponibilidad?pagina=0
Content-Type: application/json

{
  "fechaEntrada": "2028-03-10",
  "fechaSalida": "2028-03-12",
  "capacidadMinima": 2,
  "ocupantes": [
    {"documento": "CC-9001", "nombre": "Ana Ramírez", "fechaNacimiento": "1990-05-12"},
    {"documento": "CC-9002", "nombre": "Luis Gómez", "fechaNacimiento": "1988-02-20"},
    {"documento": "TI-9003", "nombre": "Sofía Gómez", "fechaNacimiento": "2020-03-02"}
  ]
}

### 2.3 CU-03 Crear la reserva (queda PENDIENTE; abre el folio) -> 201 + Location
POST {{host}}/api/reservas
Content-Type: application/json

{
  "identificacionApartamento": "{{apt}}",
  "fechaEntrada": "2028-03-10",
  "fechaSalida": "2028-03-12",
  "canalOrigen": "PORTAL",
  "horaEstimadaLlegada": "16:00",
  "titular": {"documento": "CC-9001", "nombre": "Ana Ramírez", "fechaNacimiento": "1990-05-12"},
  "ocupantes": [
    {"documento": "CC-9001", "nombre": "Ana Ramírez", "fechaNacimiento": "1990-05-12"},
    {"documento": "CC-9002", "nombre": "Luis Gómez", "fechaNacimiento": "1988-02-20"},
    {"documento": "TI-9003", "nombre": "Sofía Gómez", "fechaNacimiento": "2020-03-02"}
  ]
}

> {%
    client.global.set("codigoA", response.body.codigo);
    client.global.set("valorTotalA", response.body.valorTotal);
%}

### 2.4 Consultar la reserva por su código -> 200
GET {{host}}/api/reservas/{{codigoA}}

### 2.5 [409 · L-11 anticipo] Confirmar SIN haber pagado el anticipo -> 409
PUT {{host}}/api/reservas/{{codigoA}}/confirmar
Content-Type: application/json

{"autor": "Ana Ramírez"}

### 2.6 CU-08 Registrar el pago (se paga el valor total, que cubre el anticipo) -> 201
POST {{host}}/api/reservas/{{codigoA}}/folio/pagos
Content-Type: application/json

{"medio": "TRANSFERENCIA", "fecha": "2026-11-02", "valor": {{valorTotalA}}}

### 2.7 Confirmar la reserva (hora de llegada ya informada, anticipo cubierto) -> 200 CONFIRMADA
PUT {{host}}/api/reservas/{{codigoA}}/confirmar
Content-Type: application/json

{"autor": "Ana Ramírez"}

### 2.8 CU-04 Modificar: ampliar a 3 noches (el ajuste queda en el folio, la política no cambia) -> 200
PUT {{host}}/api/reservas/{{codigoA}}/modificar
Content-Type: application/json

{
  "fechaEntrada": "2028-03-10",
  "fechaSalida": "2028-03-13",
  "autor": "Ana Ramírez",
  "ocupantes": [
    {"documento": "CC-9001", "nombre": "Ana Ramírez", "fechaNacimiento": "1990-05-12"},
    {"documento": "CC-9002", "nombre": "Luis Gómez", "fechaNacimiento": "1988-02-20"},
    {"documento": "TI-9003", "nombre": "Sofía Gómez", "fechaNacimiento": "2020-03-02"}
  ]
}

### 2.9 Consultar el folio: cargo de alojamiento, ajuste por la modificación, pago y saldo -> 200
GET {{host}}/api/reservas/{{codigoA}}/folio

### 2.10 CU-05 Cancelar (retención según la política congelada; devolución como saldo a favor) -> 200 CANCELADA
PUT {{host}}/api/reservas/{{codigoA}}/cancelar
Content-Type: application/json

{"motivo": "Cambio de planes", "autor": "Ana Ramírez"}

### 2.11 Folio tras cancelar: reverso del alojamiento, penalidad (si aplica) y saldo -> 200
GET {{host}}/api/reservas/{{codigoA}}/folio

### 2.12 Las noches quedaron libres (RN-12): la misma estancia vuelve a aparecer disponible -> 200
POST {{host}}/api/disponibilidad
Content-Type: application/json

{
  "fechaEntrada": "2028-03-10",
  "fechaSalida": "2028-03-12",
  "ocupantes": [{"documento": "CC-9001", "nombre": "Ana Ramírez", "fechaNacimiento": "1990-05-12"}]
}

### 2.13 Listar reservas con filtros (más recientes primero) -> 200
GET {{host}}/api/reservas?estado=CANCELADA&apartamento={{apt}}&canal=PORTAL&titular=CC-9001&entradaDesde=2028-01-01&entradaHasta=2028-12-31&pagina=0

# =====================================================================================================
# PARTE 3 · ESCENARIOS 409 (una regla de negocio violada por cada uno)
# =====================================================================================================

### 3.0 Preparación: reserva B sin hora de llegada y confirmable (se usa en varios escenarios) -> 201
POST {{host}}/api/reservas
Content-Type: application/json

{
  "identificacionApartamento": "{{apt}}",
  "fechaEntrada": "2028-04-20",
  "fechaSalida": "2028-04-22",
  "canalOrigen": "DIRECTO",
  "titular": {"documento": "CC-9101", "nombre": "Marta Ríos", "fechaNacimiento": "1985-09-09"},
  "ocupantes": [{"documento": "CC-9101", "nombre": "Marta Ríos", "fechaNacimiento": "1985-09-09"}]
}

> {%
    client.global.set("codigoB", response.body.codigo);
    client.global.set("valorTotalB", response.body.valorTotal);
%}

