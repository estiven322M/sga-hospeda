# =====================================================================================================
# PARTE 8 · SOPORTE DEL FRONTEND (guías 15, 18 y 20): CORS, mis reservas, salidas previstas, búsqueda por nombre y
#           estado operativo. Todos los escenarios verifican el CUERPO (y las cabeceras, en CORS).
# CORS: el origen autorizado es el de la propiedad sga.cors.origenes-permitidos (por defecto http://localhost:5173).
# =====================================================================================================

### 8.1 [CORS] Preflight del navegador desde el origen del frontend, SIN token -> 200 con las cabeceras de autorización
OPTIONS {{host}}/api/reservas
Origin: http://localhost:5173
Access-Control-Request-Method: POST
Access-Control-Request-Headers: authorization,content-type

> {%
    client.test("8.1 el preflight del origen autorizado se responde sin token y declara lo permitido", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.headers.valueOf("Access-Control-Allow-Origin") === "http://localhost:5173",
            "Allow-Origin: " + response.headers.valueOf("Access-Control-Allow-Origin"));
        const metodos = response.headers.valueOf("Access-Control-Allow-Methods") || "";
        client.assert(metodos.indexOf("POST") >= 0 && metodos.indexOf("PUT") >= 0 && metodos.indexOf("GET") >= 0, "métodos: " + metodos);
        client.assert(metodos.indexOf("DELETE") < 0, "no se autoriza DELETE: la eliminación es lógica");
        const cabeceras = (response.headers.valueOf("Access-Control-Allow-Headers") || "").toLowerCase();
        client.assert(cabeceras.indexOf("authorization") >= 0 && cabeceras.indexOf("content-type") >= 0, "cabeceras: " + cabeceras);
    });
%}

### 8.2 [CORS] Preflight desde un origen NO autorizado -> 403 y sin la cabecera que lo autorizaría
OPTIONS {{host}}/api/reservas
Origin: http://sitio-ajeno.example
Access-Control-Request-Method: POST
Access-Control-Request-Headers: authorization,content-type

> {%
    client.test("8.2 un origen ajeno no recibe permiso", function () {
        client.assert(response.status === 403, "código " + response.status);
        client.assert(response.headers.valueOf("Access-Control-Allow-Origin") === null, "no debe traer Allow-Origin");
    });
%}

### 8.3 [CORS] Una respuesta real al origen del frontend expone la cabecera Location -> 200
GET {{host}}/api/apartamentos/{{apt}}
Origin: http://localhost:5173
Authorization: Bearer {{tokenRecepcion}}

> {%
    client.test("8.3 la respuesta autoriza al origen y expone Location", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.headers.valueOf("Access-Control-Allow-Origin") === "http://localhost:5173", "Allow-Origin");
        client.assert((response.headers.valueOf("Access-Control-Expose-Headers") || "").indexOf("Location") >= 0,
            "Expose-Headers: " + response.headers.valueOf("Access-Control-Expose-Headers"));
    });
%}

### 8.4 [GET /api/reservas/mias] La huésped 1 ve SUS reservas (por el documento de su token), de 10 en 10 -> 200
GET {{host}}/api/reservas/mias
Authorization: Bearer {{tokenHuesped1}}

> {%
    client.test("8.4 mis reservas: solo las de la huésped 1, paginadas", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.tamanio === 10, "tamanio: " + response.body.tamanio);
        client.assert(response.body.contenido.length >= 1, "debe tener al menos su reserva sembrada");
        client.assert(response.body.contenido.every(r => r.canalOrigen === "PORTAL"), "las de la huésped 1 son del PORTAL");
        client.assert(response.body.contenido.some(r => r.estado === "PENDIENTE"), "incluye su reserva PENDIENTE sembrada");
        const fechas = response.body.contenido.map(r => r.creadaEn);
        client.assert(JSON.stringify(fechas) === JSON.stringify(fechas.slice().sort().reverse()), "de la más reciente a la más antigua");
    });
    client.global.set("misCodigosHuesped1", response.body.contenido.map(r => r.codigo).sort().join(","));
%}

