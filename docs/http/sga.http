### 8.11 [GET /api/reservas?nombreTitular=] Búsqueda por el nombre del titular: contiene, sin importar mayúsculas -> 200
GET {{host}}/api/reservas?nombreTitular=TITULAR%20cc-1002
Authorization: Bearer {{tokenRecepcion}}

> {%
    client.test("8.11 el nombre se busca por texto contenido y sin distinguir mayúsculas", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.contenido.length === 1, "reservas: " + response.body.contenido.length);
        client.assert(response.body.contenido[0].nombreTitular === "Titular CC-1002", "titular: " + response.body.contenido[0].nombreTitular);
        client.assert(response.body.contenido[0].estado === "CONFIRMADA", "estado: " + response.body.contenido[0].estado);
    });
    client.global.set("codigoCC1002", response.body.contenido[0].codigo);
    client.global.set("entradaCC1002", response.body.contenido[0].fechaEntrada);
    client.global.set("salidaCC1002", response.body.contenido[0].fechaSalida);
%}

### 8.12 [GET /api/reservas?titular=] El filtro titular sigue siendo el DOCUMENTO exacto: un nombre no encuentra nada -> 200 vacío
GET {{host}}/api/reservas?titular=Titular%20CC-1002
Authorization: Bearer {{tokenRecepcion}}

> {%
    client.test("8.12 titular no cambió de significado", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.contenido.length === 0, "reservas: " + response.body.contenido.length);
    });
%}

### 8.13 [GET /api/reservas?salidaDesde&salidaHasta] Salidas previstas de un día (el día de salida de la reserva de CC-1002) -> 200
GET {{host}}/api/reservas?salidaDesde={{salidaCC1002}}&salidaHasta={{salidaCC1002}}
Authorization: Bearer {{tokenRecepcion}}

> {%
    client.test("8.13 las salidas del día incluyen la reserva y solo las de ese día", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.contenido.some(r => r.codigo === client.global.get("codigoCC1002")), "debe incluir la reserva de CC-1002");
        client.assert(response.body.contenido.every(r => r.fechaSalida === client.global.get("salidaCC1002")), "todas salen ese día");
    });
%}

### 8.14 [GET /api/reservas?entradaDesde&entradaHasta] Llegadas previstas de un día (el día de entrada de esa reserva) -> 200
GET {{host}}/api/reservas?entradaDesde={{entradaCC1002}}&entradaHasta={{entradaCC1002}}
Authorization: Bearer {{tokenRecepcion}}

> {%
    client.test("8.14 las llegadas del día incluyen la reserva y solo las de ese día", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.contenido.some(r => r.codigo === client.global.get("codigoCC1002")), "debe incluir la reserva de CC-1002");
        client.assert(response.body.contenido.every(r => r.fechaEntrada === client.global.get("entradaCC1002")), "todas entran ese día");
    });
%}

