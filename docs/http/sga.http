### 7.9 [RP-02] Cotizar 7 noches (1 al 8 de febrero) -> 200: bruto 840.000, 10 %, descuento 84.000, total 756.000
POST {{host}}/api/cotizaciones
Authorization: Bearer {{tokenRecepcion}}
Content-Type: application/json

{
  "identificacionApartamento": "{{apt}}",
  "fechaEntrada": "2028-02-01",
  "fechaSalida": "2028-02-08",
  "ocupantes": [{"documento": "CC-9701", "nombre": "Adulto Uno", "fechaNacimiento": "1990-01-01"}]
}

> {%
    client.test("7.9 con 7 noches se descuenta el 10 % una sola vez", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.noches === 7, "noches: " + response.body.noches);
        client.assert(response.body.desglose.length === 7, "desglose: " + response.body.desglose.length);
        client.assert(response.body.subtotalBruto === 840000, "subtotalBruto: " + response.body.subtotalBruto);
        client.assert(response.body.porcentajeDescuento === 10, "porcentajeDescuento: " + response.body.porcentajeDescuento);
        client.assert(response.body.descuento === 84000, "descuento: " + response.body.descuento);
        client.assert(response.body.total === response.body.subtotalBruto - response.body.descuento,
            "total (" + response.body.total + ") debe ser bruto - descuento");
        client.assert(response.body.total === 756000, "total: " + response.body.total);
        const sumaNoches = response.body.desglose.reduce((suma, n) => suma + n.subtotal, 0);
        client.assert(sumaNoches === 840000, "el desglose noche por noche suma el bruto: " + sumaNoches);
    });
    client.global.set("totalCotizado7", response.body.total);
%}

