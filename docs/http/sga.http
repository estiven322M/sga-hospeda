# =====================================================================================================
# PARTE 2 · FLUJO COMPLETO DE UNA RESERVA (todos deben dar 2xx salvo los marcados 409)
# =====================================================================================================

### 2.1 CU-01 Cotizar la estancia (2 adultos y 1 niño: el niño no genera cargo, RN-05 y RN-06) -> 200
POST {{host}}/api/cotizaciones
Authorization: Bearer {{tokenHuesped}}
Content-Type: application/json

{
  "identificacionApartamento": "{{apt}}",
  "fechaEntrada": "2028-03-10",
  "fechaSalida": "2028-03-12",
  "ocupantes": [
    {"documento": "CC-9001", "nombre": "Ana Ramírez", "fechaNacimiento": "1990-05-12"},
    {"documento": "CC-9002", "nombre": "Luis Gómez", "fechaNacimiento": "1988-02-20"},
    {"documento": "TI-9003", "nombre": "Sofía Gómez", "fechaNacimiento": "2020-03-02"}
  ]
}

> {%
    client.test("2.1 CU-01 Cotizar la estancia (2 adultos y 1 niño: el niño no genera cargo, RN-05 y RN-06)", function () {
        client.assert(response.status === 200, "código " + response.status);
        client.assert(response.body.identificacionApartamento === "APT-101", "identificacionApartamento: " + response.body.identificacionApartamento);
        client.assert(typeof response.body.fechaEntrada === "string", "fechaEntrada debe ser string");
        client.assert(typeof response.body.fechaSalida === "string", "fechaSalida debe ser string");
        client.assert(response.body.noches === 2, "noches: " + response.body.noches);
        client.assert(Array.isArray(response.body.desglose), "desglose debe ser una lista");
        client.assert(typeof response.body.subtotalBruto === "number", "subtotalBruto debe ser number");
        client.assert(typeof response.body.porcentajeDescuento === "number", "porcentajeDescuento debe ser number");
        client.assert(typeof response.body.descuento === "number", "descuento debe ser number");
        client.assert(typeof response.body.total === "number", "total debe ser number");
        client.assert(response.body.moneda === "COP", "moneda: " + response.body.moneda);
    });
%}

### 2.2 CU-02 Consultar disponibilidad de la misma estancia (filtro de capacidad mínima) -> 200
POST {{host}}/api/disponibilidad?pagina=0
Authorization: Bearer {{tokenHuesped}}
Content-Type: application/json

{
  "fechaEntrada": "2028-03-10",
  "fechaSalida": "2028-03-12",
