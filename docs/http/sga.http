### 3.14 [409 · RN-07] Reservar noches con bloqueo vigente (10 al 13 de julio: 3 noches en ALTA, así que cumple RP-01) -> 409 por el bloqueo
# Con 3 noches la estancia cumple la estancia mínima de ALTA (RP-01): el único motivo del 409 es el bloqueo (RN-07).
POST {{host}}/api/reservas
Authorization: Bearer {{tokenRecepcion}}
Content-Type: application/json

{
  "identificacionApartamento": "{{aptBloqueo}}",
  "fechaEntrada": "2028-07-10",
  "fechaSalida": "2028-07-13",
  "canalOrigen": "DIRECTO",
  "titular": {"documento": "CC-9500", "nombre": "Elena Mora", "fechaNacimiento": "1991-11-11"},
  "ocupantes": [{"documento": "CC-9500", "nombre": "Elena Mora", "fechaNacimiento": "1991-11-11"}]
}

> {%
    client.test("3.14 el 409 es por el bloqueo vigente (RN-07), no por la estancia mínima (RP-01)", function () {
        client.assert(response.status === 409, "código " + response.status);
        client.assert(response.body.status === 409, "status del cuerpo: " + response.body.status);
        client.assert(response.body.mensaje === "El apartamento tiene un bloqueo vigente en las fechas solicitadas: Mantenimiento de la cocina",
            "mensaje: " + response.body.mensaje);
        client.assert(response.body.mensaje.indexOf("estancia mínima") < 0, "no debe ser la regla RP-01");
        client.assert(response.body.trace === undefined, "no debe devolver trazas técnicas");
    });
%}

### 3.15a Crear el apartamento (nace inactivo) -> 201 la primera vez; si ya existe de una corrida anterior, 409 por L-04
POST {{host}}/api/apartamentos
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "identificacion": "DEMO-SIN-TARIFAS",
  "nombre": "Apartamento de prueba",
  "descripcion": "Apartamento de demostración, sin tarifas todavía",
  "dormitorios": 1,
  "capacidad": 2,
  "dotacion": ["Nevera", "Wi-Fi"],
  "caracteristicas": ["VISTA_PANORAMICA"]
}

> {%
    client.test("3.15a nace inactivo y devuelve lo que se guardó (o 409 si ya existía de una corrida anterior)", function () {
        client.assert(response.status === 201 || response.status === 409, "código " + response.status);
        if (response.status === 201) {
            client.assert(response.body.activo === false, "debe nacer inactivo");
            client.assert(response.body.descripcion === "Apartamento de demostración, sin tarifas todavía", "descripción");
            client.assert(JSON.stringify(response.body.dotacion) === JSON.stringify(["Nevera", "Wi-Fi"]), "dotación en su orden");
            client.assert(JSON.stringify(response.body.caracteristicas) === JSON.stringify(["VISTA_PANORAMICA"]), "características");
        } else {
            client.assert(response.body.mensaje.indexOf("Ya existe un apartamento") === 0, "mensaje: " + response.body.mensaje);
        }
    });
%}

