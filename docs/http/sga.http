--SgaFrontera--

> {%
    client.test("11.27 [7.3] La primera imagen de un apartamento queda como principal", function () {
        client.assert(response.status === 201, "código " + response.status);
        client.assert(response.body.imagenes.length === 1 && response.body.imagenes[0].principal === true, "la única es la principal");
        client.assert(response.body.imagenPrincipal === response.body.imagenes[0].url, "imagenPrincipal: " + response.body.imagenPrincipal);
        client.global.set("idUnica", response.body.imagenes[0].id);
    });
%}

