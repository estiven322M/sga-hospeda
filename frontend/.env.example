# Plantilla de variables de entorno. Para un entorno propio (por ejemplo el backend desplegado) copie este archivo como
# .env.local (no se versiona) y cambie los valores. Vite carga .env.development con "npm run dev" y .env.production con "npm run build".
#
# URL base de la API, con el prefijo /api. El backend debe autorizar el origen del frontend en su propiedad
# sga.cors.origenes-permitidos (por defecto http://localhost:5173).
VITE_API_URL=http://localhost:8080/api
# Nombre que se muestra en el encabezado.
VITE_NOMBRE_ALOJAMIENTO=Hospeda

# Edad desde la que alguien cuenta como adulto responsable. Solo sirve para AVISAR en el formulario de reserva (RP-03):
# la regla real y su umbral viven en el backend (propiedad de configuración), que es quien acepta o rechaza la reserva.
# Debe coincidir con la del backend para que el aviso sea exacto; si falta o no es un entero, el aviso no se muestra.
VITE_EDAD_ADULTO_RESPONSABLE=18
