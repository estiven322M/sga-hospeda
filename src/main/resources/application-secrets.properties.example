# Copie este archivo como application-secrets.properties en la misma carpeta.
# Ese archivo NO se versiona (.gitignore). Mínimo 32 caracteres (256 bits) para HS256.
# Genere una clave aleatoria con:
#   macOS / Linux / Git Bash:  openssl rand -base64 48
#   Windows PowerShell:        [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# En despliegue o en GitHub Actions se usa la variable de entorno SGA_JWT_SECRET, que tiene prioridad.
sga.jwt.secret=reemplace-por-una-clave-aleatoria-de-al-menos-32-caracteres
