# Copie este archivo como application-secrets.properties en la misma carpeta.
# Ese archivo NO se versiona (.gitignore). Mínimo 32 caracteres (256 bits) para HS256.
# Genere una clave aleatoria con:
#   macOS / Linux / Git Bash:  openssl rand -base64 48
#   Windows PowerShell:        [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# En despliegue o en GitHub Actions se usa la variable de entorno SGA_JWT_SECRET, que tiene prioridad.
sga.jwt.secret=reemplace-por-una-clave-aleatoria-de-al-menos-32-caracteres

# --- Imágenes de apartamentos y foto de perfil (7.3, 7.2): SOLO si quiere guardarlas en Cloudinary --------------
# Por defecto el sistema usa el almacén LOCAL (sga.imagenes.proveedor=local en application.properties): guarda en la carpeta ./imagenes
# y no necesita nada de esto. Para usar Cloudinary (plan gratuito, sin tarjeta): copie del panel de Cloudinary el "Cloud name", la
# "API Key" y el "API Secret", escríbalos aquí y active el proveedor (también puede usar las variables de entorno
# SGA_IMAGENES_CLOUDINARY_CLOUD_NAME, SGA_IMAGENES_CLOUDINARY_API_KEY, SGA_IMAGENES_CLOUDINARY_API_SECRET y SGA_IMAGENES_PROVEEDOR=cloudinary):
#   sga.imagenes.proveedor=cloudinary
sga.imagenes.cloudinary.cloud-name=
sga.imagenes.cloudinary.api-key=
sga.imagenes.cloudinary.api-secret=

# --- Notificaciones por correo (10.3.2-A): SOLO si quiere enviar correos de verdad -------------------------------
# Por defecto el sistema usa el proveedor LOCAL (sga.notificaciones.proveedor=local en application.properties): no necesita
# nada de esto, no sale a internet y los avisos se leen en GET /api/notificaciones (administrador).
# Para activar Gmail (ver README, "Notificaciones por correo"):
#   1. Cuenta de Google con verificación en dos pasos y una "contraseña de aplicación" de 16 caracteres (sin espacios).
#   2. Llene estas dos propiedades y active el proveedor, en application-secrets.properties o con variables de entorno
#      SPRING_MAIL_USERNAME, SPRING_MAIL_PASSWORD y SGA_NOTIFICACIONES_PROVEEDOR=smtp:
#        sga.notificaciones.proveedor=smtp
spring.mail.username=
spring.mail.password=

# --- Notificaciones por Brevo (API HTTPS): alternativa al SMTP, sirve en Render --------------------------------
# Render (plan gratuito) bloquea los puertos SMTP salientes, así que allí no funciona Gmail por SMTP: Brevo envía por HTTPS (443).
# Cuenta gratuita (300 correos al día, sin tarjeta): cree una clave en Brevo > SMTP y API > Claves API y verifique el correo remitente
# (Brevo > Remitentes). Llene estas dos propiedades y active el proveedor, o use las variables de entorno
# SGA_NOTIFICACIONES_PROVEEDOR=brevo, SGA_NOTIFICACIONES_BREVO_API_KEY y SGA_NOTIFICACIONES_BREVO_REMITENTE:
#   sga.notificaciones.proveedor=brevo
sga.notificaciones.brevo.api-key=
sga.notificaciones.brevo.remitente=
